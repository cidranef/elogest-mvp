# =========================================================
# ELOGEST — EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ETAPA 52.8.1 — ARMAZENAMENTO PRIVADO DE DOCUMENTOS
#
# Nunca salve credenciais reais neste arquivo.
# Copie somente as chaves necessárias para o ambiente local
# ou cadastre os valores diretamente no Railway.
# =========================================================

# Aplicação
APP_URL=
DATABASE_URL=
MAIL_FROM=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NODE_ENV=production
RESEND_API_KEY=

# IA opcional para atas
OPENAI_API_KEY=
OPENAI_ASSEMBLY_MINUTE_MODEL=gpt-5.4-mini
OPENAI_ASSEMBLY_MINUTE_ENABLED=true
OPENAI_ASSEMBLY_MINUTE_TIMEOUT_MS=45000

# Armazenamento privado de documentos
# Desenvolvimento local:
DOCUMENT_STORAGE_DRIVER=local

# Produção com Cloudflare R2:
# DOCUMENT_STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=elogest-documentos
