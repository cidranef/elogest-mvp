generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMINISTRADORA
  SINDICO
  MORADOR
}

enum Status {
  ACTIVE
  INACTIVE
}

// =========================================================
// ETAPA 47 - STATUS DO PLANO DA ADMINISTRADORA
//
// Controla a situação comercial da administradora dentro do
// EloGest, sem misturar com Status ACTIVE/INACTIVE operacional.
//
// ACTIVE:
// plano ativo e liberado.
//
// TRIALING:
// período de avaliação/teste controlado.
//
// PAST_DUE:
// pagamento pendente futuramente, sem necessariamente bloquear
// tudo de imediato.
//
// SUSPENDED:
// acesso comercial suspenso.
//
// CANCELED:
// plano cancelado.
//
// EXPIRED:
// período de avaliação ou contrato expirado.
// =========================================================

enum AdministratorPlanStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

// =========================================================
// ETAPA 45 - TIPO DO CONDOMÍNIO
//
// Define a natureza principal do condomínio.
//
// RESIDENTIAL:
// condomínio residencial.
//
// COMMERCIAL:
// condomínio comercial.
//
// MIXED:
// condomínio misto, com unidades residenciais e comerciais.
//
// HORIZONTAL:
// condomínio horizontal / casas.
//
// OTHER:
// reservado para casos específicos.
// =========================================================

enum CondominiumType {
  RESIDENTIAL
  COMMERCIAL
  MIXED
  HORIZONTAL
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// =========================================================
// ETAPA 40.7.2 - ALVO DA AVALIAÇÃO DO ATENDIMENTO
//
// Define quem está sendo avaliado em uma avaliação.
//
// ADMINISTRADORA:
// - avaliação feita por síndico;
// - avaliação feita por morador/proprietário quando o chamado
//   estiver atribuído à administradora ou sem responsável.
//
// SINDICO:
// - avaliação feita por morador/proprietário quando o chamado
//   estiver atribuído ao síndico.
//
// ELOGEST:
// - avaliação futura feita pela administradora sobre a plataforma.
//
// FORNECEDOR:
// - avaliação futura de prestador/fornecedor.
// =========================================================

enum TicketRatingTargetType {
  ADMINISTRADORA
  SINDICO
  ELOGEST
  FORNECEDOR
}

// =========================================================
// ETAPA 27.1 - PAPEL DO VÍNCULO DO USUÁRIO
//
// IMPORTANTE:
//
// O enum Role continua existindo para manter compatibilidade
// com o sistema atual.
//
// O novo enum AccessRole representa o papel do usuário dentro
// de um vínculo específico.
//
// Exemplo:
// Um mesmo User pode ter:
// - AccessRole MORADOR no Condomínio Alpha / Apto 101;
// - AccessRole PROPRIETARIO no Condomínio Beta / Apto 305;
// - AccessRole SINDICO no Condomínio Gama.
// =========================================================

enum AccessRole {
  SUPER_ADMIN
  ADMINISTRADORA
  SINDICO
  MORADOR
  PROPRIETARIO
  CONSELHEIRO
}

// =========================================================
// ETAPA 43 - TIPO DE VÍNCULO COM A UNIDADE
//
// Este enum separa claramente quem é proprietário,
// quem mora/ocupa a unidade e quem possui autorização
// operacional.
//
// Isso evita tratar todo mundo como "morador" e prepara
// o EloGest para assembleias, votação, comunicados formais,
// permissões por unidade e vínculos múltiplos.
// =========================================================

enum UnitPersonLinkType {
  OWNER
  RESIDENT
  TENANT
  DEPENDENT
