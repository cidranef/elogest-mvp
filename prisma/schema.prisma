// =========================================================

// =========================================================
// ETAPA 46 - REDE DE FORNECEDORES ELOGEST
//
// A Etapa 46 passa a tratar fornecedores/prestadores como
// ativos da plataforma EloGest.
//
// A arquitetura fica dividida em três camadas:
//
// 1) Provider:
// fornecedor global da Rede EloGest.
//
// 2) AdministratorProvider:
// homologação e regras internas da administradora.
//
// 3) CondominiumProvider:
// vínculo operacional do fornecedor com condomínios específicos.
//
// Importante:
// - Provider não pertence obrigatoriamente a uma administradora.
// - AdministratorProvider define se a administradora usa/homologa.
// - CondominiumProvider define se atende determinado condomínio.
// =========================================================

enum ProviderEntityType {
  COMPANY
  INDIVIDUAL
  PROFESSIONAL
  OTHER
}

enum ProviderGlobalStatus {
  DRAFT
  ACTIVE
  IN_REVIEW
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum ProviderVisibility {
  PRIVATE
  ELOGEST_NETWORK
  PUBLIC_FUTURE
}

enum ProviderOrigin {
  ELOGEST
  ADMINISTRATOR
  INDICATION
  IMPORT
  OTHER
}

enum AdministratorProviderStatus {
  IN_REVIEW
  HOMOLOGATED
  ACTIVE
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum CondominiumProviderStatus {
  ACTIVE
  SUSPENDED
  ENDED
  INACTIVE
}

enum CondominiumProviderLinkType {
  CONTRACT
  RECURRING
  ON_DEMAND
  INDICATED
